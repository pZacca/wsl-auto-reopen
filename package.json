{
  "name": "wsl-auto-reopen",
  "displayName": "WSL Auto Reopen",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "zacca",
  "author": "Pedro Zaccaria",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pZacca/wsl-auto-reopen"
  },
  "bugs": {
    "url": "https://github.com/pZacca/wsl-auto-reopen/issues"
  },
  "homepage": "https://github.com/pZacca/wsl-auto-reopen#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/pZacca"
  },
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wsl",
    "remote",
    "remote-wsl",
    "unc",
    "windows"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "wslAutoReopen.reopenInWindows",
        "title": "%command.reopenInWindows%",
        "category": "WSL Auto Reopen"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "wslAutoReopen.reopenInWindows",
          "when": "remoteName == wsl"
        }
      ],
      "statusBar/remoteIndicator": [
        {
          "command": "wslAutoReopen.reopenInWindows",
          "when": "remoteName == wsl",
          "group": "remote_20_wsl_autoReopen@1"
        }
      ]
    },
    "configuration": {
      "title": "WSL Auto Reopen",
      "properties": {
        "wslAutoReopen.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.enabled%"
        },
        "wslAutoReopen.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.exclude%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "package": "vsce package --allow-star-activation",
    "install:windows": "npm run package && sh scripts/install-windows.sh",
    "publish:vsce": "vsce publish --allow-star-activation",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "typescript": "^7.0.2"
  }
}
